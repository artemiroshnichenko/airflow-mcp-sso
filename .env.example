# Copy to .env. Read by both the server and the CLI. Usually nothing here is needed:
# instances.json already holds prod, stage, test and local, and SSO instances authenticate
# through the browser cookie.

# AIRFLOW_MCP_DEFAULT_ENV=prod
# AIRFLOW_MCP_READONLY_ENVS=prod,stage
# AIRFLOW_MCP_TIMEOUT=30
# AIRFLOW_MCP_COOKIE_NAME=_token

# Per environment overrides, name in upper case
# AIRFLOW_MCP_PROD_URL=https://airflow.example.com
# AIRFLOW_MCP_PROD_TOKEN=
# AIRFLOW_MCP_LOCAL_USERNAME=
# AIRFLOW_MCP_LOCAL_PASSWORD=
